+</style>
+</head>
+<body>
+<div class="viz-root">
+<div class="wrap" id="app"></div>
+<div id="tip"></div>
+</div>
+<script type="application/json" id="data">__DATA__</script>
+<script>
+(() => {
+  const D = JSON.parse(document.getElementById('data').textContent);
+  const M = D.meta, Q = D.questions;
+  const SPLIT = !M.has_grmp;          // 没有 GRMP 计时日志:工具时间没拆分,两段标「未拆分」
+  const KINDS = [
+    { k: 'ttft', n: '模型·等首字', c: 'var(--k1)' },
+    { k: 'gen', n: '模型·思考与输出', c: 'var(--k2)' },
+    { k: 'grmp', n: '工具·GRMP 与数据库', c: 'var(--k3)', sim: SPLIT },
+    { k: 'local', n: '工具·脚本本地', c: 'var(--k4)', sim: SPLIT },
+    { k: 'idle', n: '运行时空档', c: 'var(--k0)' },
+  ];
+  const KMAP = Object.fromEntries(KINDS.map(k => [k.k, k]));
+  const INK_ON = { ttft: '#fff', gen: '#fff', grmp: '#fff', local: '#0b0b0b', idle: '#0b0b0b' };
+  const SVGNS = 'http://www.w3.org/2000/svg';
+  const app = document.getElementById('app');
+  const tip = document.getElementById('tip');
+
+  // ---------- 小工具(所有数据文字一律 textContent) ----------
+  function el(tag, attrs, ...kids) {
+    const e = document.createElement(tag);
+    for (const [a, v] of Object.entries(attrs || {})) {
+      if (v == null) continue;
+      if (a === 'class') e.className = v; else if (a === 'style') e.style.cssText = v;
+      else if (a.startsWith('on')) e.addEventListener(a.slice(2), v); else e.setAttribute(a, v);
+    }
+    for (const k of kids.flat()) if (k != null && k !== false) e.append(k instanceof Node ? k : document.createTextNode(String(k)));
+    return e;
+  }
+  function sv(tag, attrs, ...kids) {
+    const e = document.createElementNS(SVGNS, tag);
+    for (const [a, v] of Object.entries(attrs || {})) e.setAttribute(a, v);
+    for (const k of kids) if (k != null) e.append(k instanceof Node ? k : document.createTextNode(String(k)));
+    return e;
+  }
+  const fmt = s => s >= 120 ? `${Math.floor(s / 60)} 分 ${Math.round(s % 60)} 秒` : (s < 1 ? `${s.toFixed(2)} 秒` : `${s.toFixed(1)} 秒`);
+  const pct = (a, b) => b ? `${(a / b * 100).toFixed(a / b < 0.1 ? 1 : 0)}%` : '0%';
+  const kTok = n => n >= 1000 ? `${(n / 1000).toFixed(1)}K` : String(n);
+  const num = n => Number(n).toLocaleString('zh-CN');
+  const spd = v => v ? `${Math.round(v)} token/秒` : '—';
+  function niceStep(max, n) {
+    const raw = max / n, p = Math.pow(10, Math.floor(Math.log10(raw))), m = raw / p;
+    return (m <= 1 ? 1 : m <= 2 ? 2 : m <= 5 ? 5 : 10) * p;
+  }
+  function showTip(ev, title, value, rows, hint) {
+    tip.replaceChildren(el('div', { class: 'muted' }, title), el('div', { class: 'tv' }, value),
+      ...(rows || []).map(r => el('div', { class: 'tr' }, el('span', { class: 'lk', style: `background:${r.c || 'var(--ink-3)'}` }), r.n, el('span', { class: 'vv' }, r.v))),
+      hint ? el('div', { class: 'hint2' }, hint) : null);
+    tip.style.display = 'block';
+    const x = Math.min(ev.clientX + 14, innerWidth - tip.offsetWidth - 8), y = Math.min(ev.clientY + 14, innerHeight - tip.offsetHeight - 8);
+    tip.style.left = x + 'px'; tip.style.top = y + 'px';
+  }
+  const hideTip = () => { tip.style.display = 'none'; };
+  function hover(node, fn) {
+    node.addEventListener('pointermove', e => fn(e));
+    node.addEventListener('pointerleave', hideTip);
+    node.setAttribute('tabindex', '0');
+    node.addEventListener('focus', () => { const r = node.getBoundingClientRect(); fn({ clientX: r.right, clientY: r.top }); });
+    node.addEventListener('blur', hideTip);
+  }
+  // 一轮里各段时长(按类型合计)
+  function roundKinds(r) {
+    const o = { idle: r.idle, ttft: r.ttft, gen: r.gen, grmp: r.grmp, local: r.local };
+    return KINDS.map(k => ({ ...k, v: o[k.k] || 0 }));
+  }
+  const roundOwn = r => r.end - r.t + r.idle;
+
+  // ---------- 页头 ----------
+  const maskTxt = M.masked_text || '无';
+  const tzTxt = M.utc_offset === 8 ? '北京时间' : `UTC${M.utc_offset >= 0 ? '+' : ''}${M.utc_offset}`;
+  app.append(
+    el('h1', {}, '智能体交互耗时报告', el('span', { class: 'muted', style: 'font-size:15px;font-weight:400;margin-left:10px' }, M.detail ? '详细版' : '摘要版')),
+    el('div', { class: 'sub' }, `${Q.length} 次提问 · 生成于 ${M.generated}（${tzTxt}）· 纯脚本统计，不调模型`),
